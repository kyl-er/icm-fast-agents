{
  "title": "icm-fast-agents",
  "size": [270, 480],
  "fps": 30,
  "scenes": [
    {"name": "title", "duration": 5, "background": {"gradient": [0.22, 0.04]},
     "layers": [{"type": "tesseract", "draw": 1.5, "size": 0.30, "tint": "white", "opacity": 0.8}],
     "captions": [{"at": 0.4, "until": 4.8, "lines": ["Small fast", "models."], "y": 0.12, "size": 0.12},
                  {"at": 2.2, "until": 4.8, "lines": ["A tiny", "harness."], "y": 0.86, "size": 0.12}],
     "out": "cut"},
    {"name": "folders", "duration": 6, "background": "black",
     "layers": [{"type": "field", "expr": "where(mod((0.7-y)*6.67, 1) < 0.55, 1, 0) * where((0.7-y)*6.67 < 0.5 + u*13, 1, 0) * where(abs(x) < 0.7, 1, 0) * where(y < 0.7, 1, 0) * where(y > -0.8, 1, 0)", "tint": "ghost", "opacity": 0.55}],
     "captions": [{"at": 0.3, "until": 5.8, "lines": ["The folder is", "the program."], "y": 0.09, "size": 0.09},
                  {"at": 2.0, "until": 5.8, "lines": ["Ten numbered", "folders."], "y": 0.92, "size": 0.09}],
     "out": "cut"},
    {"name": "prompt", "duration": 5, "background": "black",
     "layers": [{"type": "life", "rule": "B3/S23", "density": 0.22, "rate": 8, "cell": 4, "tint": "ghost", "opacity": 0.6}],
     "captions": [{"at": 0.3, "until": 4.8, "lines": ["A 750-token", "prompt."], "y": 0.2, "size": 0.12},
                  {"at": 2.2, "until": 4.8, "lines": ["One card per", "command."], "y": 0.8, "size": 0.12}],
     "out": "cut"},
    {"name": "json", "duration": 6, "background": "black",
     "layers": [{"type": "clip", "scene": "neurons", "from": 16.4, "to": 24.4, "tint": "ghost", "opacity": 0.85}],
     "captions": [{"at": 0.3, "until": 5.8, "lines": ["Every call is", "one JSON line."], "y": 0.1, "size": 0.09},
                  {"at": 3.0, "until": 5.8, "lines": ["Lines become a", "graph of nodes."], "y": 0.9, "size": 0.09}],
     "out": "cut"},
    {"name": "email", "duration": 7, "background": {"gradient": [0.16, 0.03]},
     "layers": [{"type": "wireframe", "shape": "icosahedron", "size": 0.26, "draw": 1.5, "tint": "white"}],
     "captions": [{"at": 0.3, "until": 6.8, "lines": ["Email triage:", "a fast model", "extracts."], "y": 0.13, "size": 0.09},
                  {"at": 3.2, "until": 6.8, "lines": ["A decision model", "decides in", "about 180 ms."], "y": 0.85, "size": 0.09}],
     "out": "cut"},
    {"name": "rounds", "duration": 7, "background": "black",
     "layers": [{"type": "field", "expr": "where(abs(x+0.4) < 0.22, 1, 0) * where((y+0.9)/1.8 < 0.65*min(u*2.5, 1), 1, 0) * where(y > -0.9, 1, 0)", "tint": "grey", "opacity": 0.8, "blend": "add"},
                {"type": "field", "expr": "where(abs(x-0.4) < 0.22, 1, 0) * where((y+0.9)/1.8 < 0.82*min(max(u*2.5-0.8, 0), 1), 1, 0) * where(y > -0.9, 1, 0)", "tint": "white", "blend": "add"}],
     "captions": [{"at": 0.3, "until": 6.8, "lines": ["After three", "rounds."], "y": 0.09, "size": 0.09},
                  {"at": 2.2, "until": 6.8, "lines": ["65% to 82%", "on unseen mail."], "y": 0.93, "size": 0.09}],
     "out": "fade"},
    {"name": "end", "duration": 4, "background": "black",
     "layers": [{"type": "wireframe", "shape": "torus", "size": 0.22, "draw": 1.0, "at": [0.5, 0.35], "tint": "white"}],
     "captions": [{"at": 0.5, "until": 4.0, "lines": ["Watch it", "work."], "y": 0.72, "size": 0.15}],
     "out": "fade"}
  ]
}
