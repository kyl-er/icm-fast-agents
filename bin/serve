#!/usr/bin/env python3
"""bin/serve: the one small server behind the screen. Stdlib only.  http://127.0.0.1:8990

  /                      the built screen (05-screen/dist)
  GET  /api/runs         saved + live runs, newest first
  GET  /api/trace/<run>  one run's JSONL
  GET  /api/stream       Server-Sent Events: every new trace line of every live run
  GET  /api/tasks        example tasks          GET /api/models   chat models with a key
  POST /api/run          {"task":"web-1"} or {"prompt":"...","category":"files"}, optional "model", "harness"
  POST /api/replay       {"run":"<saved run>","speed":4}  re-emit a saved trace as a live run
  GET  /api/tree         repo files with sizes, for the context view
  GET  /api/vox          {"hasKey": bool}  (is DEEPGRAM_API_KEY set; the key itself is never sent)

Binds to loopback only. Stop with Ctrl-C.
"""
import json, os, pathlib, subprocess, sys, threading, time, tomllib
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / '01-config'))
import registry  # noqa: E402

DIST, LIVE, SAVED = ROOT / '05-screen/dist', ROOT / '04-traces/live', ROOT / '04-traces/saved'
PORT = int(os.environ.get('PORT', 8990))
LIVE.mkdir(parents=True, exist_ok=True)


def summary(p, saved):
    first = last = None
    n = 0
    with open(p) as f:
        for line in f:
            if line.strip():
                n += 1
                last = line
                first = first or line
    if not first:
        return None
    s, e = json.loads(first), json.loads(last)
    done = e.get('kind') == 'run_end'
    return {'run': p.stem, 'category': s.get('category'), 'task': s.get('task'), 'model': s.get('model'), 'harness': s.get('harness'),
            'ok': e.get('ok') if done else None, 'ms': e.get('ms') if done else None, 'done': done, 'events': n, 'saved': saved,
            'input': s.get('input'), 'ts': s.get('ts')}


def runs():
    out = {}
    for d, saved in ((LIVE, False), (SAVED, True)):
        # newest 300 per folder: an email batch writes thousands of small traces
        for p in sorted(d.glob('*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True)[:300]:
            try:
                r = summary(p, saved)
            except Exception:
                r = None
            if r:
                out[r['run']] = r
    return sorted(out.values(), key=lambda r: r['ts'] or 0, reverse=True)


def tasks():
    return [{'id': t['id'], 'category': t['category'], 'prompt': t['prompt']}
            for t in tomllib.loads((ROOT / '02-agent/tasks/tasks.toml').read_text())['task']]


def models():
    K = registry.keys()
    return [a for a, m in registry.CFG['models'].items()
            if m['kind'] == 'chat' and m['tools'] and any(K.get(registry.CFG['providers'][p]['key_env']) for p, _ in m['routes'])]


def tree():
    """Every file tracked or untracked-but-not-ignored in the repo, with its size. tokens is bytes / 4, an estimate."""
    names = subprocess.run(['git', 'ls-files', '-co', '--exclude-standard'], cwd=ROOT, capture_output=True, text=True).stdout.split('\n')
    out = []
    for n in names:
        f = ROOT / n
        if n and f.is_file() and not n.startswith(('vault/', '04-traces/', '05-screen/dist/', '05-screen/public/traces/')):
            b = f.stat().st_size
            out.append({'path': n, 'bytes': b, 'tokens': b // 4})
    return {'root': str(ROOT), 'files': out, 'total_tokens': sum(x['tokens'] for x in out)}


class H(SimpleHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=str(DIST), **kw)

    def log_message(self, *a):
        pass

    def send_json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = self.path.split('?')[0]
        if p == '/api/runs':
            return self.send_json(runs())
        if p == '/api/tasks':
            return self.send_json(tasks())
        if p == '/api/models':
            return self.send_json(models())
        if p == '/api/tree':
            return self.send_json(tree())
        if p == '/api/vox':
            return self.send_json({'hasKey': bool(registry.keys().get('DEEPGRAM_API_KEY'))})
        if p.startswith('/api/trace/'):
            name = pathlib.Path(p).name
            for d in (LIVE, SAVED):
                f = d / f'{name}.jsonl'
                if f.is_file():
                    body = f.read_bytes()
                    self.send_response(200)
                    self.send_header('Content-Type', 'application/x-ndjson; charset=utf-8')
                    self.send_header('Content-Length', str(len(body)))
                    self.end_headers()
                    return self.wfile.write(body)
            return self.send_json({'error': 'no such run'}, 404)
        if p == '/api/stream':
            return self.stream()
        if not DIST.is_dir():
            return self.send_json({'error': 'screen not built: cd 05-screen && npm install && npm run build'}, 503)
        return super().do_GET()

    def stream(self):
        self.send_response(200)
        self.send_header('Content-Type', 'text/event-stream')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('Connection', 'close')
        self.end_headers()
        pos = {p: p.stat().st_size for p in LIVE.glob('*.jsonl')}  # only lines written from now on
        beat = time.time()
        try:
            while True:
                sent = False
                for p in sorted(LIVE.glob('*.jsonl')):
                    try:
                        size = p.stat().st_size
                    except OSError:
                        continue
                    at = pos.get(p, 0)
                    if size > at:
                        with open(p, 'rb') as f:
                            f.seek(at)
                            chunk = f.read()
                        keep = chunk.rfind(b'\n') + 1  # only whole lines
                        pos[p] = at + keep
                        for line in chunk[:keep].splitlines():
                            if line.strip():
                                self.wfile.write(b'data: ' + line + b'\n\n')
                                sent = True
                if sent:
                    self.wfile.flush()
                elif time.time() - beat > 10:
                    self.wfile.write(b': ping\n\n')
                    self.wfile.flush()
                    beat = time.time()
                time.sleep(0.15)
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass

    def do_POST(self):
        n = int(self.headers.get('Content-Length') or 0)
        try:
            body = json.loads(self.rfile.read(n) or b'{}')
        except Exception:
            return self.send_json({'error': 'bad json'}, 400)
        if self.path == '/api/run':
            cmd = [str(ROOT / 'bin/agent')]
            if body.get('task'):
                if body['task'] not in {t['id'] for t in tasks()}:
                    return self.send_json({'error': 'unknown task'}, 400)
                cmd += ['--task', body['task']]
            elif body.get('prompt'):
                cmd += [str(body['prompt'])[:2000], '--category', str(body.get('category') or 'adhoc')]
            else:
                return self.send_json({'error': 'task or prompt needed'}, 400)
            if body.get('model'):
                if body['model'] not in registry.CFG['models']:
                    return self.send_json({'error': 'unknown model'}, 400)
                cmd += ['--model', body['model']]
            if body.get('harness') in ('rig', 'langchain'):
                cmd += ['--harness', body['harness']]
            subprocess.Popen(cmd + ['--quiet'], cwd=ROOT, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return self.send_json({'ok': True})
        if self.path == '/api/replay':
            name = pathlib.Path(str(body.get('run', ''))).name
            if not (SAVED / f'{name}.jsonl').is_file():
                return self.send_json({'error': 'no such saved run'}, 404)
            subprocess.Popen([sys.executable, str(ROOT / 'bin/replay'), name, '--emit', '--speed', str(float(body.get('speed', 1)))],
                             cwd=ROOT, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return self.send_json({'ok': True})
        return self.send_json({'error': 'not found'}, 404)


if __name__ == '__main__':
    srv = ThreadingHTTPServer(('127.0.0.1', PORT), H)
    srv.daemon_threads = True
    print(f'screen: http://127.0.0.1:{PORT}   (Ctrl-C to stop)', flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
