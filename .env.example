# Copy to .env and fill in. Never commit .env. Only the keys for providers you use are needed.
# The registry (01-config/registry.py) reads, in order: the shell environment, ./.env, ~/.config/icm-agent-demo/keys.env
INCEPTION_API_KEY=your-inception-key        # Mercury 3 (extraction, default fast agent)
OPENROUTER_API_KEY=your-openrouter-key      # most chat models
CEREBRAS_API_KEY=your-cerebras-key          # gpt-oss-120b, qwen at Cerebras speed (watch spend)
GROQ_API_KEY=your-groq-key                  # gpt-oss on Groq
CELERIS_API_KEY=your-celeris-key            # Celeris-1 chat + Celeris decision model
GEMINI_API_KEY=your-gemini-key              # optional
TYPESAFE_API_KEY=your-typesafe-key          # Jev decision model (System One API)
DEEPGRAM_API_KEY=your-deepgram-key          # Vox voice panel; without it the panel shows "needs key"
